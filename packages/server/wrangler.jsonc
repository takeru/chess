{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "chess",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // The web client (packages/web) is built into ../web/dist and served as static assets.
  // Requests under /api/ always reach the Worker.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoom" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom", "Lobby"] }],
  "observability": { "enabled": true }
}
